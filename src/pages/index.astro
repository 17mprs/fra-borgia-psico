                    <span class="summary-label" style="font-size: 1.125rem;">Totale:</span>
                    <span class="summary-value" style="font-size: 1.25rem; color: var(--success);" id="summaryPrice">GRATUITO</span>
                </div>
                <button class="cta-btn" id="confirmBooking" style="width: 100%; margin-top: 1rem;">
                    Conferma Prenotazione
                </button>
            </div>
        </div>
    </div>
</section>

