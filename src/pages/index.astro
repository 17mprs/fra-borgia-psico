<style is:global>
.cal { width: 100%; }
.cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; }
.cal-title { font-weight: 600; text-transform: capitalize; }
.cal-nav { background: transparent; border: 1px solid var(--border); color: #fff; width: 2rem; height: 2rem; border-radius: 50%; cursor: pointer; font-size: 1rem; line-height: 1; }
.cal-nav:disabled { opacity: 0.25; cursor: not-allowed; }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.25rem; }
.cal-dow { text-align: center; font-size: 0.7rem; opacity: 0.7; padding: 0.2rem 0; }
.cal-day { aspect-ratio: 1; border-radius: 0.5rem; border: 1px solid transparent; background: transparent; color: #fff; font: inherit; font-size: 0.85rem; }
.cal-day:disabled { opacity: 0.22; cursor: not-allowed; }
.cal-day.avail { border-color: var(--border); background: rgba(255, 244, 250, 0.12); cursor: pointer; font-weight: 600; }
.cal-day.avail:hover { background: rgba(255, 244, 250, 0.22); }
.cal-day.selected { background: #fff7f3; color: #361423; border-color: #fff7f3; }
.cal-day:focus-visible, .cal-nav:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
</style>

<script>
// CONFIGURAZIONE
const bookingState = {
    date: null,
    time: null,
    service: 'individuale_online'
};

// Primi colloqui: solo martedì e mercoledì, dalle 8 alle 18 (slot da 1 ora)
const ORARI = ['08:00','09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00','17:00'];
const weeklySlots = {
  0: [], // domenica
  1: [], // lunedì
  2: ORARI, // martedì
  3: ORARI, // mercoledì
  4: [], // giovedì
  5: [], // venerdì
  6: []  // sabato
};

const bookedSlots = {
    '2025-01-15': ['09:00', '14:00'],
    '2025-01-16': ['10:30']
};

const services = {
  'individuale_online': { name: 'Terapia Individuale Online', price: 50 },
  'individuale_presenza': { name: 'Terapia Individuale in Presenza', price: 75 },
  'coppia_online': { name: 'Spazio della Coppia Online', price: 100 },
  'coppia_coterapia': { name: 'Spazio della Coppia in Co-terapia', price: 120 },
  'famiglia': { name: 'Psicoterapia Familiare in Co-terapia', price: 120 },
  'parent_training': { name: 'Parent Training', price: 90 }
};

// CALENDARIO: solo i giorni con slot sono selezionabili
const MESI_AVANTI = 3;
const pad = n => String(n).padStart(2, '0');
const toISO = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
const today = new Date(); today.setHours(0, 0, 0, 0);
let calMonth = new Date(today.getFullYear(), today.getMonth(), 1);
let calSelected = null;

function renderCalendar() {
    const cal = document.getElementById('calendar');
    const first = new Date(calMonth);
    const last = new Date(calMonth.getFullYear(), calMonth.getMonth() + 1, 0);
    const limit = new Date(today.getFullYear(), today.getMonth() + MESI_AVANTI, 1);
    const title = first.toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });

    let html = `<div class="cal-head">
        <button type="button" class="cal-nav" id="calPrev" aria-label="Mese precedente" ${first <= new Date(today.getFullYear(), today.getMonth(), 1) ? 'disabled' : ''}>‹</button>
        <span class="cal-title">${title}</span>
        <button type="button" class="cal-nav" id="calNext" aria-label="Mese successivo" ${first >= limit ? 'disabled' : ''}>›</button>
    </div><div class="cal-grid">`;
    ['Lun','Mar','Mer','Gio','Ven','Sab','Dom'].forEach(d => html += `<div class="cal-dow">${d}</div>`);
    for (let i = 0; i < (first.getDay() + 6) % 7; i++) html += '<div></div>';
    for (let day = 1; day <= last.getDate(); day++) {
        const d = new Date(first.getFullYear(), first.getMonth(), day);
        const iso = toISO(d);
        const ok = (weeklySlots[d.getDay()] || []).length > 0 && d >= today;
        const cls = 'cal-day' + (ok ? ' avail' : '') + (iso === calSelected ? ' selected' : '');
        html += `<button type="button" class="${cls}" data-date="${iso}" ${ok ? '' : 'disabled'} ${iso === calSelected ? 'aria-pressed="true"' : ''}>${day}</button>`;
    }
    html += '</div>';
    cal.innerHTML = html;

    document.getElementById('calPrev').addEventListener('click', () => { calMonth = new Date(calMonth.getFullYear(), calMonth.getMonth() - 1, 1); renderCalendar(); });
    document.getElementById('calNext').addEventListener('click', () => { calMonth = new Date(calMonth.getFullYear(), calMonth.getMonth() + 1, 1); renderCalendar(); });
    cal.querySelectorAll('.cal-day.avail').forEach(btn => btn.addEventListener('click', () => {
        calSelected = btn.dataset.date;
        const input = document.getElementById('bookingDate');
        input.value = calSelected;
        input.dispatchEvent(new Event('change'));
        renderCalendar();
    }));
}
renderCalendar();

// GESTIONE DATA
document.getElementById('bookingDate').addEventListener('change', function() {
    const date = new Date(this.value + 'T00:00:00');
    bookingState.date = this.value;
    bookingState.time = null;
    
    const dayOfWeek = date.getDay();
    const slots = weeklySlots[dayOfWeek] || [];
    const booked = bookedSlots[this.value] || [];
    
    const container = document.getElementById('timeSlots');
    container.innerHTML = '';
    
    if (slots.length === 0) {
        container.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; color: var(--gray); padding: 1rem;">Nessuna disponibilità per questa data</div>';
        return;
    }
    
    slots.forEach(time => {
        const slot = document.createElement('div');
        slot.className = 'time-slot';
        slot.textContent = time;
        
        const [h, m] = time.split(':').map(Number);
        const slotDate = new Date(date); slotDate.setHours(h, m, 0, 0);
        if (booked.includes(time) || slotDate <= new Date()) {
            slot.classList.add('disabled');
        } else {
            slot.addEventListener('click', () => selectTime(time, slot));
        }
        
        container.appendChild(slot);
    });
    
    updateSummary();
});

// GESTIONE SERVIZIO
document.getElementById('bookingService').addEventListener('change', function() {
    bookingState.service = this.value;
    updateSummary();
});

// SELEZIONE ORARIO
function selectTime(time, element) {
    document.querySelectorAll('.time-slot').forEach(el => el.classList.remove('selected'));
    element.classList.add('selected');
    bookingState.time = time;
    updateSummary();
}

// AGGIORNA RIEPILOGO
function updateSummary() {
    const summary = document.getElementById('bookingSummary');
    
    if (bookingState.date && bookingState.time) {
        summary.classList.add('show');
        
        const date = new Date(bookingState.date + 'T00:00:00');
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        
        document.getElementById('summaryDate').textContent = date.toLocaleDateString('it-IT', options);
        document.getElementById('summaryTime').textContent = bookingState.time;
        document.getElementById('summaryService').textContent = services[bookingState.service].name;
        
        const price = services[bookingState.service].price;
        document.getElementById('summaryPrice').textContent = price === 0 ? 'GRATUITO' : `€${price}`;
    } else {
        summary.classList.remove('show');
    }
}

// CONFERMA PRENOTAZIONE
const WEB3FORMS_KEY = 'INSERISCI_ACCESS_KEY';

document.getElementById('confirmBooking').addEventListener('click', async () => {
    if (!bookingState.date || !bookingState.time) {
        showToast('Seleziona data e orario', 'error');
        return;
    }

    const name = document.getElementById('bookingName').value.trim();
    const phone = document.getElementById('bookingPhone').value.trim();
    const email = document.getElementById('bookingEmail').value.trim();
    if (!name || !phone || !email || !document.getElementById('bookingEmail').checkValidity()) {
        showToast('Inserisci nome, telefono ed email validi', 'error');
        return;
    }
    if (!document.getElementById('bookingPrivacy').checked) {
        showToast('Devi acconsentire al trattamento dei dati', 'error');
        return;
    }
    if (document.getElementById('bookingBotcheck').checked) return;

    const btn = document.getElementById('confirmBooking');
    btn.disabled = true;

    const dataLeggibile = new Date(bookingState.date + 'T00:00:00')
        .toLocaleDateString('it-IT', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

    try {
        const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
                access_key: WEB3FORMS_KEY,
                subject: `Nuova richiesta di colloquio - ${name}`,
                from_name: 'Sito psicologaperinatale.com',
                replyto: email,
                Nome: name,
                Telefono: phone,
                Email: email,
                Servizio: services[bookingState.service].name,
                Prezzo: `€${services[bookingState.service].price}`,
                Data: dataLeggibile,
                Orario: bookingState.time
            })
        });
        const out = await res.json();
        if (!res.ok || !out.success) throw new Error(out.message || 'Errore invio');
    } catch (err) {
        console.error(err);
        showToast('Invio non riuscito. Riprova o contattaci al telefono.', 'error');
        btn.disabled = false;
        return;
    }
    btn.disabled = false;

    const booking = {
        id: 'BOOK-' + Date.now(),
        date: bookingState.date,
        time: bookingState.time,
        service: services[bookingState.service].name,
        price: services[bookingState.service].price,
        timestamp: new Date().toISOString()
    };
    
    // Salva in localStorage
    let bookings = JSON.parse(localStorage.getItem('bookings') || '[]');
    bookings.push(booking);
    localStorage.setItem('bookings', JSON.stringify(bookings));
    
    // Aggiungi a bookedSlots
    if (!bookedSlots[bookingState.date]) bookedSlots[bookingState.date] = [];
    bookedSlots[bookingState.date].push(bookingState.time);
    
    console.log('✅ Prenotazione:', booking);
    
    showToast('Richiesta inviata! La dott.ssa ti ricontatterà per confermare.', 'success');
    
    // Reset dopo 2 secondi
    setTimeout(() => {
        document.getElementById('bookingDate').value = '';
        calSelected = null;
        renderCalendar();
        document.getElementById('timeSlots').innerHTML = '<div style="grid-column: 1 / -1; text-align: center; color: var(--gray); padding: 1rem;">Seleziona una data per vedere gli orari disponibili</div>';
        document.getElementById('bookingSummary').classList.remove('show');
        bookingState.date = null;
        bookingState.time = null;
    }, 2000);
});

// TOAST NOTIFICATION
function showToast(message, type = 'success') {
    const toast = document.getElementById('toast');
    const toastMessage = document.getElementById('toastMessage');
    
    toast.className = 'toast ' + type;
    toastMessage.textContent = message;
    toast.classList.add('show');
    
    setTimeout(() => {
        toast.classList.remove('show');
    }, 4000);
}

// AUTO-SELECT SERVIZIO DA CARD
document.querySelectorAll('[data-service]').forEach(btn => {
  btn.addEventListener('click', function() {
    const serviceId = this.getAttribute('data-service');
    const select = document.getElementById('bookingService');
    if (select && serviceId) {
      select.value = serviceId;
      bookingState.service = serviceId;
    }
  });
});

// SMOOTH SCROLL
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    });
});

console.log('✅ Mini Booking App Caricata');
</script>

