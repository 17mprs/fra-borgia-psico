<script>
const floatsFooter = document.querySelector('footer');
const floatsTel = document.querySelector('.tel-float');
const floatsWa = document.querySelector('.wa-float');
if (floatsFooter && floatsTel && floatsWa && 'IntersectionObserver' in window) {
  new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      document.body.classList.toggle('floats-hidden', entry.isIntersecting);
    });
  }, { rootMargin: '0px', threshold: 0 }).observe(floatsFooter);
}
</script>
<script>
// Parallasse orizzontale: l'immagine scorre di lato mentre la pagina scorre in verticale
const coverBand = document.querySelector('.cover-band');
const coverImg = coverBand && coverBand.querySelector('.cover-band-img');
if (coverBand && coverImg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  coverBand.classList.add('is-parallax');
  let coverTicking = false;
  const coverUpdate = () => {
    coverTicking = false;
    // il banner è fermo (sticky) per tutta la corsa: progress va da 0 a 1 lungo quel tratto
    const rect = coverBand.getBoundingClientRect();
    const stickyEl = coverBand.querySelector('.cover-sticky');
    const stickyTop = (window.innerHeight - stickyEl.offsetHeight) / 2;
    const travel = Math.max(1, coverBand.offsetHeight - stickyEl.offsetHeight);
    const progress = Math.min(1, Math.max(0, (stickyTop - rect.top) / travel));
    const overflow = Math.max(0, coverImg.offsetWidth - stickyEl.clientWidth);
    coverBand.style.setProperty('--px', (-overflow * progress).toFixed(1) + 'px');
  };
  const coverRequest = () => {
    if (!coverTicking) { coverTicking = true; requestAnimationFrame(coverUpdate); }
  };
  window.addEventListener('scroll', coverRequest, { passive: true });
  window.addEventListener('resize', coverRequest);
  coverUpdate();
}
</script>
